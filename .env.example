# Copy to .env (repository root) to override defaults. All values are optional.

# Folder containing the .osm.pbf, deepgloberoad/, outputs-*/, checkpoints-*/ and notebooks
# ROUTERESILIENCE_DATA_DIR=D:\routeresilience

# --- OpenStreetMap road network ---
# PBF file (default: first *.osm.pbf in the data dir)
# ROUTERESILIENCE_OSM_PBF=D:\routeresilience\southern-zone-261011.osm.pbf
# Where the road index (SQLite) and temporary files go
# ROUTERESILIENCE_CACHE_DIR=D:\routeresilience\.cache\routeresilience
# Index extent built by "Build road index" (min_lon,min_lat,max_lon,max_lat) — central Chennai
# ROUTERESILIENCE_OSM_EXTENT=80.15,12.95,80.32,13.16
# First region shown on the map (must lie inside an indexed extent)
# ROUTERESILIENCE_DEFAULT_REGION=80.215,13.02,80.265,13.065
# ROUTERESILIENCE_MAX_REGION_SEGMENTS=80000

# --- Segmentation lab ---
# ROUTERESILIENCE_DEEPGLOBE_DIR=D:\routeresilience\deepgloberoad
# ROUTERESILIENCE_CHECKPOINTS_DIR=D:\routeresilience\checkpoints-20261012T165525Z-1-001\checkpoints

# --- Research pipeline artifacts (Reports → historical runs) ---
# ROUTERESILIENCE_OUTPUTS_DIR=D:\routeresilience\outputs-20261012T170249Z-1-001\outputs
# ROUTERESILIENCE_NOTEBOOKS_DIR=D:\routeresilience

# Saved simulation runs and review decisions (never inside artifact folders)
# ROUTERESILIENCE_STATE_DIR=D:\routeresilience\backend\state
# ROUTERESILIENCE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
